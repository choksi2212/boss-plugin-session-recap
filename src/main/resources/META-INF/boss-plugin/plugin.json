{
  "manifestVersion": 1,
  "pluginId": "ai.rever.boss.plugin.dynamic.sessionrecap",
  "displayName": "Session Recap",
  "version": "0.1.0",
  "apiVersion": "1.0.93",
  "minApiVersion": "1.0.93",
  "minBossVersion": "9.4.2",
  "mainClass": "ai.rever.boss.plugin.dynamic.sessionrecap.SessionRecapDynamicPlugin",
  "type": "mixed",
  "description": "End-of-session summary combining tab, project, MCP and file events into a single readable recap",
  "author": "choksi2212",
  "url": "https://github.com/choksi2212/boss-plugin-session-recap",
  "panel": {
    "position": "left_bottom",
    "priority": 76
  },
  "sandbox": {
    "maxThreads": 4,
    "maxRestartAttempts": 3,
    "heartbeatIntervalMs": 5000
  },
  "isolationMode": "out-of-process",
  "fallback": "in-process"
}
